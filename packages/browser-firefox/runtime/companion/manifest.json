{
  "manifest_version": 2,
  "name": "Zamery Browser Companion",
  "version": "0.1.2",
  "description": "Companion for controlling the user's already-running browser through Zamery BrowserProvider.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zamery-browser-firefox@zamery.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  },
  "permissions": [
    "<all_urls>",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Zamery Browser",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["asset-discovery-v1.js", "asset-transfer-v1.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
