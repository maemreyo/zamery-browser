{
  "manifest_version": 2,
  "name": "Zamery Browser Companion (Development)",
  "version": "0.1.1",
  "description": "Development identity for the Zamery browser companion canary.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zamery-live-browser-v0c@zamery.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  },
  "permissions": [
    "<all_urls>",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Zamery Browser (Dev)",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
