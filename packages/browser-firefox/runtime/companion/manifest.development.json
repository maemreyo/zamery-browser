{
  "manifest_version": 2,
  "name": "Zamery Browser Companion (Development)",
  "version": "0.2.4",
  "description": "Development identity for Zamery Browser Companion: explicit Firefox sharing for local AI agents.",
  "icons": {
    "16": "icons/zamery-16.png",
    "32": "icons/zamery-32.png",
    "48": "icons/zamery-48.png",
    "96": "icons/zamery-96.png",
    "128": "icons/zamery-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zamery-live-browser-v0c@zamery.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  },
  "permissions": [
    "<all_urls>",
    "nativeMessaging",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "incognito": "not_allowed",
  "background": {
    "scripts": ["policy.js", "background.js", "control-ops.js", "artifacts.js", "start.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Zamery Browser Companion (Dev)",
    "default_icon": {
      "16": "icons/zamery-16.png",
      "32": "icons/zamery-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["asset-discovery-v1.js", "asset-transfer-v1.js", "asset-a1-experimental.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
