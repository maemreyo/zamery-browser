{
  "name": "@zamery/browser-firefox",
  "version": "0.2.0",
  "type": "module",
  "description": "Firefox implementation of BrowserProvider V1/V2 for a user's already-running browser.",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "runtime"
  ],
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maemreyo/zamery-browser.git",
    "directory": "packages/browser-firefox"
  },
  "homepage": "https://github.com/maemreyo/zamery-browser/tree/main/packages/browser-firefox#readme",
  "bugs": {
    "url": "https://github.com/maemreyo/zamery-browser/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @zamery/browser-provider build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@zamery/browser-provider": "workspace:*"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
